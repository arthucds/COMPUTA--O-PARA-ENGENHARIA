# A - FATORIAL
# -------------
# EXEMPLO
# Digite um inteiro não negativo: 5
# O fatorial de 5 é 120.

while True:
    numero = int(input("Digite um inteiro não negativo: "))
    
    if numero < 0:
        print("Número inválido. Por favor, digite um inteiro não negativo.")

    else:
        fatorial = 1
        for i in range(1, numero + 1):
            fatorial *= i
        print(f"O fatorial de {numero} é {fatorial}.")
        break