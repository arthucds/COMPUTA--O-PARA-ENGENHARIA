tentativas = 0

while True:
    pin = "4321"
    tentativa = input("PIN: ")
    tentativas += 1

    if tentativa != pin:
        print("Errado")

    elif tentativa == pin:
        if tentativas == 1:
            print("Correto! Você precisou de apenas uma única tentativa!")
        else:
            print("Correto! Você precisou de", tentativas, "tentativas")
        break